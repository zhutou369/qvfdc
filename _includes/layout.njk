
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - whatapp网页版登录</title>
    <style>
:root { --whatsapp-green: #25D366; --whatsapp-dark: #075E54; --bg-light: #f4f7f6; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; line-height: 1.8; color: #333; background: var(--bg-light); margin: 0; padding: 0; }
.header { background: var(--whatsapp-dark); color: white; padding: 40px 20px; text-align: center; }
.nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
.container { max-width: 1200px; margin: 30px auto; display: grid; grid-template-columns: 1fr 320px; gap: 30px; padding: 0 20px; }
.main-content { background: white; padding: 40px; border-radius: 12px; shadow: 0 4px 12px rgba(0,0,0,0.05); }
.sidebar { background: white; padding: 25px; border-radius: 12px; border: 1px solid #eee; height: fit-content; }
.article-img { width: 100%; border-radius: 8px; margin: 20px 0; max-height: 400px; object-fit: cover; }
h1, h2, h3 { color: var(--whatsapp-dark); }
.post-list { list-style: none; padding: 0; }
.post-list li { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px dashed #eee; }
.post-list a { text-decoration: none; color: #444; font-size: 15px; transition: 0.3s; }
.post-list a:hover { color: var(--whatsapp-green); }
.footer { background: #333; color: #fff; padding: 50px 20px; margin-top: 50px; text-align: center; }
.friend-links a { color: #aaa; margin: 0 10px; text-decoration: none; font-size: 14px; }
.friend-links a:hover { color: #fff; }
@media (max-width: 900px) { .container { grid-template-columns: 1fr; } }
</style>
    <!-- 51.la 统计代码 -->
    <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
    <script>LA.init({id:"3K7l95Zodr0uFrIN",ck:"3K7l95Zodr0uFrIN"})</script>
</head>
<body>
    <header class="header">
        <h1>{{ title }}</h1>
    </header>
    <div class="container">
        <main class="main-content">
            <article>
                {{ content | safe }}
                <div style="margin-top: 40px; border-top: 1px solid #eee; padding-top: 20px;">
                    {% if prevPost %}<p>上一篇：<a href="{{ prevPost.url }}">{{ prevPost.data.title }}</a></p>{% endif %}
                    {% if nextPost %}<p>下一篇：<a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></p>{% endif %}
                </div>
            </article>
        </main>
        <aside class="sidebar">
            <h3>更多相关资讯</h3>
            <ul class="post-list">
                {% for post in collections.blog %}
                <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
                {% endfor %}
            </ul>
        </aside>
    </div>
    <footer class="footer">
        <div class="friend-links">
            友情链接：
            <a href="http://qhqrl.com">whatsapp网页版登录</a> <a href="http://qhsdk.com">WhatsApp web</a> <a href="http://qvfdc.com">whatsapp网页版</a> <a href="http://rcqry.com">whatsapp网页版登入</a> <a href="http://rdqjm.com">whatsapp官方</a>
        </div>
    </footer>
</body>
</html>
